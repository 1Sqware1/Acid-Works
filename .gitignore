```gitignore
# Compiled binaries
/acidworks
*.exe
*.out
*.app

# Go build artifacts
*.test
*.prof

# Dependencies
/vendor/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.log

# Environment and local configuration
.env
.env.*
!.env.example
```